!deck chinese/04-numbers
!title Числа
!src ru>zh

# Числа — из рукописной тетради. Формат: вопрос = ответ [пиньинь] // заметка

ноль = 零 [líng]
один = 一 [yī]
два = 二 [èr]
два (перед счётным словом) = 两 [liǎng] // 两个学生 — два студента
три = 三 [sān]
четыре = 四 [sì]
пять = 五 [wǔ]
шесть = 六 [liù]
семь = 七 [qī]
восемь = 八 [bā]
девять = 九 [jiǔ]
десять = 十 [shí]
двенадцать = 十二 [shí'èr] // 十二个老师 — двенадцать учителей
