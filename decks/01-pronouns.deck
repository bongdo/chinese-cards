!deck chinese/01-pronouns
!title Местоимения
!src ru>zh

# Местоимения — из рукописной тетради. Формат: вопрос = ответ [пиньинь] // заметка

я = 我 [wǒ]
ты = 你 [nǐ]
он = 他 [tā]
она = 她 [tā]
оно = 它 [tā] // для неодушевлённых предметов
мы = 我们 [wǒmen]
вы = 你们 [nǐmen] // вежливо одному человеку: 您 nín
они = 他们 [tāmen] // если в группе есть мужчины
они (только женщины) = 她们 [tāmen]
они (о предметах) = 它们 [tāmen]
