!deck chinese/05-measure
!title Счётные слова
!src ru>zh

# Счётные слова — из рукописной тетради. Формат: вопрос = ответ [пиньинь] // заметка

(для книг, словарей, журналов) = 本 [běn] // 一本书 — одна книга
(для ручек, карандашей: длинное и тонкое) = 支 [zhī] // 三支铅笔 — три карандаша
(для плоского: бумага, карта, стол) = 张 [zhāng] // 三张纸 — три листа бумаги; 一张地图
(универсальное, для людей) = 个 [gè] // 四个学生 — четыре студента
(для вещей, багажа, одежды, дел) = 件 [jiàn] // 三件行李 — три места багажа
(кусок; также юань) = 块 [kuài] // 三块肥皂 — три куска мыла
(для порций, документов, комплектов) = 份 [fèn]
(пара) = 双 [shuāng] // 一双鞋 — пара обуви
